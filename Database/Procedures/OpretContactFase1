CREATE OR ALTER PROCEDURE dbo.OpretContactFase1
(
    @Name NVARCHAR(200),

    @Title NVARCHAR(200) = NULL,
    @Email NVARCHAR(255) = NULL,
    @Mobile NVARCHAR(50) = NULL,
    @CvrNbr NVARCHAR(50) = NULL,
    @PrimaryContactName NVARCHAR(255) = NULL,
    @PrimaryContactTypeName NVARCHAR(100) = NULL,
    @PrimaryContactEmail NVARCHAR(255) = NULL,
    @PrimaryContactMobile NVARCHAR(50) = NULL,

    @AddressLine1 NVARCHAR(255),
    @AddressLine2 NVARCHAR(255) = NULL,
    @ZipCode NVARCHAR(20),

    @BirthDate DATE = NULL,
    @SexID INT = NULL,

    @ContactTypeName NVARCHAR(100)
)
AS
BEGIN

    SET NOCOUNT ON;

    DECLARE @ShopContactID UNIQUEIDENTIFIER;
    DECLARE @PrimaryContactID UNIQUEIDENTIFIER;

    DECLARE @AddressID UNIQUEIDENTIFIER;
    DECLARE @ZipID UNIQUEIDENTIFIER;
    DECLARE @DistrictID UNIQUEIDENTIFIER;

    DECLARE @ShopContactTypeID UNIQUEIDENTIFIER;
    DECLARE @PrimaryContactTypeID UNIQUEIDENTIFIER;

    --------------------------------------------------
    -- Find Zip og District
    --------------------------------------------------

    SELECT
        @ZipID = ZipID,
        @DistrictID = DistrictID
    FROM dbo.Zip
    WHERE ZipCode = @ZipCode;

    IF @ZipID IS NULL
    BEGIN
        RAISERROR('ZipCode blev ikke fundet',16,1);
        RETURN;
    END

    --------------------------------------------------
    -- Find ContactTypeID
    --------------------------------------------------

    SELECT
        @ShopContactTypeID = ContactTypeID
    FROM dbo.ContactType
    WHERE ContactTypeName = @ContactTypeName;

    IF @ShopContactTypeID IS NULL
    BEGIN
        RAISERROR('ContactType blev ikke fundet',16,1);
        RETURN;
    END

    IF @PrimaryContactName IS NOT NULL
    BEGIN

        SELECT
            @PrimaryContactTypeID = ContactTypeID
        FROM dbo.ContactType
        WHERE ContactTypeName = @PrimaryContactTypeName;

    END

    --------------------------------------------------
    -- Find eksisterende adresse
    --------------------------------------------------

    SELECT
        @AddressID = AddressID
    FROM dbo.Address
    WHERE AddressLine1 = @AddressLine1
      AND ISNULL(AddressLine2,'') = ISNULL(@AddressLine2,'')
      AND ZipID = @ZipID;

    --------------------------------------------------
    -- Opret adresse hvis nødvendig
    --------------------------------------------------

    IF @AddressID IS NULL
    BEGIN

        SET @AddressID = NEWID();

        INSERT INTO dbo.Address
        (
            AddressID,
            AddressLine1,
            AddressLine2,
            ZipID,
            DistrictID,
            CreatedAt,
            CreatedBy
        )
        VALUES
        (
            @AddressID,
            @AddressLine1,
            @AddressLine2,
            @ZipID,
            @DistrictID,
            SYSUTCDATETIME(),
            'CreateMemberFase1'
        );

    END

    --------------------------------------------------
    -- Opret Butik / Virksomhed
    --------------------------------------------------

    SET @ShopContactID = NEWID();

    INSERT INTO dbo.Contact
    (
        ContactID,
        Name,
        Title,
        Email,
        Mobile,
        AddressID,
        DistrictID,
        ContactTypeID,
        BirthDate,
        SexID,
        CreatedAt,
        IsPrimaryContact
    )
    VALUES
    (
        @ShopContactID,
        @Name,
        @Title,
        @Email,
        @Mobile,
        @AddressID,
        @DistrictID,
        @ShopContactTypeID,
        @BirthDate,
        @SexID,
        SYSUTCDATETIME(),
        0
    );

    --------------------------------------------------
    -- Opret Primær Kontaktperson
    --------------------------------------------------

    IF @PrimaryContactName IS NOT NULL
    BEGIN

        SET @PrimaryContactID = NEWID();

        INSERT INTO dbo.Contact
        (
            ContactID,
            Name,
            Title,
            Email,
            Mobile,
            AddressID,
            DistrictID,
            ContactTypeID,
            CreatedAt,
            ReferenceContactID,
            IsPrimaryContact
        )
        VALUES
        (
            @PrimaryContactID,
            @PrimaryContactName,
            @PrimaryContactTypeName,
            @PrimaryContactEmail,
            @PrimaryContactMobile,
            @AddressID,
            @DistrictID,
            @PrimaryContactTypeID,
            SYSUTCDATETIME(),
            @ShopContactID,
            1
        );

    END

    --------------------------------------------------
    -- Returnér resultat
    --------------------------------------------------

    SELECT
        @ShopContactID AS ShopContactID,
        @PrimaryContactID AS PrimaryContactID,
        @AddressID AS AddressID;

END
GO
