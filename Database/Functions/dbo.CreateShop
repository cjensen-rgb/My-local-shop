CREATE OR ALTER PROCEDURE dbo.CreateShop
(
    @ContactID UNIQUEIDENTIFIER,
    @ShopID UNIQUEIDENTIFIER OUTPUT
)
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @ShopName NVARCHAR(400);
    DECLARE @AddressID UNIQUEIDENTIFIER;
    DECLARE @Email NVARCHAR(400);
    DECLARE @CVR NVARCHAR(20);
    DECLARE @ShopCategoryID UNIQUEIDENTIFIER;
    DECLARE @ShopStateID UNIQUEIDENTIFIER;

    SELECT
        @ShopName       = Name,
        @AddressID      = AddressID,
        @Email          = Email,
        @CVR            = CvrNbr,
        @ShopCategoryID = ShopCategoryID
    FROM dbo.Contact
    WHERE ContactID = @ContactID;

    IF @ShopCategoryID IS NULL
    BEGIN
        RAISERROR('ShopCategoryID is NULL on Contact.',16,1);
        RETURN;
    END;

    SELECT TOP 1
        @ShopStateID = ShopStateID
    FROM dbo.ShopState
    WHERE ShopStateName = 'Approved';

    IF @ShopStateID IS NULL
    BEGIN
        RAISERROR('Approved ShopState not found.',16,1);
        RETURN;
    END;

    SET @ShopID = NEWID();

    INSERT INTO dbo.Shop
    (
        ShopID,
        CreatedAt,
        UpdatedAt,
        ShopName,
        ShopStateID,
        AddressID,
        Email,
        CVR,
        ContactID,
        ShopCategoryID,
        Active,
        AcceptsShopperGroups,
        AcceptsSeniorShopperGroups,
        AcceptCafeBonus,
        AcceptCultureBonus,
        AcceptsBingo
    )
    VALUES
    (
        @ShopID,
        GETDATE(),
        GETDATE(),
        @ShopName,
        @ShopStateID,
        @AddressID,
        @Email,
        @CVR,
        @ContactID,
        @ShopCategoryID,
        1,
        1,
        0,
        1,
        1,
        1
    );
END;
GO
